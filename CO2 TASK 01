
#include <stdio.h>

int main()
{
    double price, qty, total, net;
    int senior;

    printf("Enter Medicine Price: ");
    scanf("%lf", &price);

    printf("Enter Quantity: ");
    scanf("%lf", &qty);

    printf("Senior Citizen? (1=Yes, 0=No): ");
    scanf("%d", &senior);

    double gross = price * qty;
    double discount = senior ? gross * 15 / 100 : 0;
    double tax = (gross - discount) * 5 / 100;

    total = gross - discount + tax;

    net = (total > 1000) ? total - 50 : total;

    printf("\nGross Amount: Rs %.2f", gross);
    printf("\nDiscount: Rs %.2f", discount);
    printf("\nGST: Rs %.2f", tax);
    printf("\nTotal Amount: Rs %.2f", total);
    printf("\nNet Amount: Rs %.2f\n", net);

    return 0;
}
