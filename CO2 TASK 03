
#include <stdio.h>

enum
{
    LIGHT = 0,
    FAN = 1,
    AC = 2,
    HEATER = 3,
    PUMP = 4
};

unsigned char switch_on(unsigned char reg, int dev)
{
    return reg | (1u << dev);
}

unsigned char switch_off(unsigned char reg, int dev)
{
    return reg & ~(1u << dev);
}

unsigned char toggle(unsigned char reg, int dev)
{
    return reg ^ (1u << dev);
}

int is_on(unsigned char reg, int dev)
{
    return (reg & (1u << dev)) != 0;
}

void show(unsigned char reg)
{
    for (int bit = 7; bit >= 0; bit--)
        printf("%d", (reg >> bit) & 1u);

    printf("\n");
}

int main()
{
    unsigned char reg = 0;
    int dev;

    reg = switch_on(reg, LIGHT);
    reg = switch_on(reg, AC);

    printf("Initial Register: ");
    show(reg);

    reg = toggle(reg, FAN);
    reg = switch_off(reg, LIGHT);

    printf("Final Register: ");
    show(reg);

    printf("Enter Device Number (0-4): ");
    scanf("%d", &dev);

    if (dev < 0 || dev > 4)
    {
        printf("Invalid Device Number\n");
        return 1;
    }

    printf("Device Status: %s\n",
           is_on(reg, dev) ? "ON" : "OFF");

    return 0;
}
